# Compose-level variables — read by docker compose itself for interpolation
# in docker-compose.prod.yml, NOT by the application. Application settings
# live in the repo-root .env (HAALAND_* keys, see .env.example).
#
#   cp infra/gcp/.env.compose.example infra/gcp/.env.compose
#
# and pass it with --env-file on every compose invocation.

# Public hostname Caddy requests a certificate for. With no domain of your
# own, use the VM's static external IP through sslip.io, e.g.
#   HAALAND_DOMAIN=34-126-100-20.sslip.io
HAALAND_DOMAIN=

# Postgres credentials. Generate the password, do not reuse the dev default:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=haaland
POSTGRES_PASSWORD=
POSTGRES_DB=haaland

# Absolute host path to the GitHub App private key, mounted read-only into
# the api and worker containers at /run/secrets/github-app.pem. Leave unset
# when HAALAND_GITHUB_AUTH_MODE=pat.
GITHUB_APP_PEM_PATH=

# The same bearer token as HAALAND_API_AUTH_TOKEN in the repo-root .env, and
# it must match — the dashboard container gets it here rather than through
# env_file so it is not also handed the GitHub and LLM credentials it has no
# use for. Its /dash-api proxy attaches the token server-side; a mismatch
# makes every panel in the dashboard read "invalid or missing API token".
HAALAND_API_AUTH_TOKEN=
