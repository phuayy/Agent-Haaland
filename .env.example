# Copy to .env. Every one of these is read by apps/api/src/haaland/config.py
# (pydantic-settings, prefix HAALAND_) which fails fast at startup if a
# required value is missing.

# Core
HAALAND_ENV=dev
HAALAND_DATABASE_URL=postgresql+asyncpg://haaland:haaland@localhost:5432/haaland
HAALAND_REDIS_URL=redis://localhost:6379/0
HAALAND_APP_BASE_URL=http://localhost:8000
HAALAND_SECRET_KEY=change-me
HAALAND_VAULT_ENCRYPTION_KEY=  # 32-byte key, base64-encoded — generate with:
                                # python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"

# LLM — defaults to the offline `fake` provider, no key needed to try the loop end to end
HAALAND_LLM_PROVIDER=fake
HAALAND_ANTHROPIC_API_KEY=
HAALAND_OPENAI_API_KEY=
HAALAND_MODEL_PRIMARY=claude-opus-5
HAALAND_MODEL_CHEAP=claude-haiku-4-5
HAALAND_MODEL_REPORT=claude-sonnet-5
HAALAND_LLM_MAX_USD_PER_INCIDENT=2.00
HAALAND_LLM_MAX_USD_PER_DAY=50.00

# GitHub — two auth modes.
#   app (recommended): a GitHub App installation. Least-privilege, revocable,
#     short-lived tokens. Set the three APP_* values below.
#   pat: a classic/fine-grained personal access token with Contents RW +
#     Pull requests RW on the target repo. Single-dev fallback.
HAALAND_GITHUB_AUTH_MODE=pat
HAALAND_GITHUB_TOKEN=
HAALAND_GITHUB_APP_ID=
# Either paste the PEM inline (replace newlines with \n) or point at the file:
HAALAND_GITHUB_APP_PRIVATE_KEY=
HAALAND_GITHUB_APP_PRIVATE_KEY_PATH=
HAALAND_GITHUB_APP_INSTALLATION_ID=
HAALAND_GITHUB_WEBHOOK_SECRET=

# Notifications — comma-separated channels; empty disables. e.g. "lark"
HAALAND_NOTIFY_CHANNELS=
# Lark custom bot: group chat -> Settings -> Bots -> Add Bot -> Custom Bot
HAALAND_LARK_WEBHOOK_URL=
# Only if the bot has "Signature verification" enabled:
HAALAND_LARK_WEBHOOK_SECRET=

# Redaction
HAALAND_REDACTION_ENGINE=regex
HAALAND_VAULT_TTL_HOURS=24

# Behaviour
HAALAND_MAX_FIX_ATTEMPTS=3
HAALAND_APPROVAL_TIMEOUT_MINUTES=30
HAALAND_DEDUPE_WINDOW_SECONDS=300
# pytest runs the target repo's (and the model's) code. Outside the Docker
# sandbox that means executing it on YOUR machine — explicit opt-in only:
HAALAND_ALLOW_HOST_TEST_EXECUTION=false
# Comma-separated allowed CORS origins; "*" is dev-only
HAALAND_CORS_ORIGINS=*

# Alertmanager (Phase 1 alert-triggered path — not implemented in this slice)
HAALAND_ALERTMANAGER_WEBHOOK_TOKEN=
