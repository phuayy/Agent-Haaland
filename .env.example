# Copy to .env. Every one of these is read by apps/api/src/haaland/config.py
# (pydantic-settings, prefix HAALAND_) which fails fast at startup if a
# required value is missing.

# Core
HAALAND_ENV=dev
HAALAND_DATABASE_URL=postgresql+asyncpg://haaland:haaland@localhost:5432/haaland
HAALAND_REDIS_URL=redis://localhost:6379/0
HAALAND_APP_BASE_URL=http://localhost:8000
HAALAND_SECRET_KEY=change-me
HAALAND_VAULT_ENCRYPTION_KEY=  # 32-byte key, base64-encoded — generate with:
                                # python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Bearer token required on every /api/* route (webhooks verify their own
# signatures instead). Empty = open access, dev-only convenience; prod
# refuses to start without it. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Send as:  Authorization: Bearer <token>
HAALAND_API_AUTH_TOKEN=

# LLM — `fake` is the offline provider, no key needed to try the loop end to end.
# `deepseek` is the default real provider; `anthropic` and `openai` also work.
# The MODEL_* names must match the selected provider's vocabulary — config.py
# refuses to start if they don't (deepseek-* / claude-* / gpt-*).
HAALAND_LLM_PROVIDER=deepseek
HAALAND_DEEPSEEK_API_KEY=  # platform.deepseek.com -> API keys
# OpenAI-compatible surface. Do NOT point this at https://api.deepseek.com/anthropic:
# that endpoint ignores cache_control and has no structured-output path.
HAALAND_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Thinking mode on the structured (deliverable) calls. Off trades diagnosis
# quality for latency and output tokens; exploration turns never use it.
HAALAND_DEEPSEEK_THINKING=true
HAALAND_ANTHROPIC_API_KEY=
HAALAND_OPENAI_API_KEY=
HAALAND_MODEL_PRIMARY=deepseek-v4-flash
HAALAND_MODEL_CHEAP=deepseek-v4-flash
HAALAND_MODEL_REPORT=deepseek-v4-pro
HAALAND_LLM_MAX_USD_PER_INCIDENT=2.00
HAALAND_LLM_MAX_USD_PER_DAY=50.00
# Agentic diagnosis: the model greps/reads the workspace clone itself before
# committing to a root cause (read-only tools, capped per-call output, every
# turn budgeted). Inert with providers that aren't tool-capable (fake, openai).
HAALAND_AGENTIC_DIAGNOSIS_ENABLED=true
HAALAND_TOOL_LOOP_MAX_ITERATIONS=12

# GitHub — two auth modes.
#   app (recommended): a GitHub App installation. Least-privilege, revocable,
#     short-lived tokens. Set the three APP_* values below.
#   pat: a classic/fine-grained personal access token with Contents RW +
#     Pull requests RW on the target repo. Single-dev fallback.
HAALAND_GITHUB_AUTH_MODE=pat
HAALAND_GITHUB_TOKEN=
HAALAND_GITHUB_APP_ID=
# Either paste the PEM inline (replace newlines with \n) or point at the file:
HAALAND_GITHUB_APP_PRIVATE_KEY=
HAALAND_GITHUB_APP_PRIVATE_KEY_PATH=
HAALAND_GITHUB_APP_INSTALLATION_ID=
HAALAND_GITHUB_WEBHOOK_SECRET=

# Notifications — comma-separated channels; empty disables. e.g. "lark"
HAALAND_NOTIFY_CHANNELS=
# Lark transport (docs/13):
#   webhook — custom bot bound to one group chat. No org onboarding, push-only.
#   app     — internal application installed into the Lark tenant. Any chat or
#             person, editable cards, and the prerequisite for card callbacks.
HAALAND_LARK_MODE=webhook
# Which Lark cloud the app is registered on: global (larksuite.com) | feishu (feishu.cn)
HAALAND_LARK_DOMAIN=global

# --- mode=webhook: group chat -> Settings -> Bots -> Add Bot -> Custom Bot
HAALAND_LARK_WEBHOOK_URL=
# Only if the bot has "Signature verification" enabled:
HAALAND_LARK_WEBHOOK_SECRET=

# --- mode=app: open.larksuite.com/app -> Create custom app -> Credentials
HAALAND_LARK_APP_ID=
HAALAND_LARK_APP_SECRET=
# Default destination: chat_id (oc_…), open_id (ou_…) or a work email.
# GET /api/notifications/lark/chats lists the chats the bot has been added to.
HAALAND_LARK_DEFAULT_RECEIVE_ID=
# Only consulted for ids with no recognisable prefix
HAALAND_LARK_DEFAULT_RECEIVE_ID_TYPE=chat_id
# Event Subscriptions page — needed only for POST /webhooks/lark/card
HAALAND_LARK_ENCRYPT_KEY=
HAALAND_LARK_VERIFICATION_TOKEN=

# Redaction
HAALAND_REDACTION_ENGINE=regex
HAALAND_VAULT_TTL_HOURS=24

# Worker — per-job ceiling for one debug session (arq cancels past this).
# The arq default of 300s is too tight for clone + tool loop + six LLM stages.
HAALAND_ARQ_JOB_TIMEOUT_SECONDS=1800

# Behaviour
HAALAND_MAX_FIX_ATTEMPTS=3
HAALAND_APPROVAL_TIMEOUT_MINUTES=30
HAALAND_DEDUPE_WINDOW_SECONDS=300
# pytest runs the target repo's (and the model's) code. Outside the Docker
# sandbox that means executing it on YOUR machine — explicit opt-in only:
HAALAND_ALLOW_HOST_TEST_EXECUTION=false
# Comma-separated allowed CORS origins; "*" is dev-only
HAALAND_CORS_ORIGINS=*

# Alertmanager (Phase 1 alert-triggered path — not implemented in this slice)
HAALAND_ALERTMANAGER_WEBHOOK_TOKEN=
